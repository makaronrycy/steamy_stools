# === GitHub Configuration ===
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_URL=https://github.com/owner/repo.git
OWNER=owner
REPO_NAME=repo
MAIN_BRANCH=main

# === SonarQube Configuration ===
SONAR_TOKEN=your_sonar_token
SONAR_PROJECT_KEY=Project
SONAR_PROJECT_NAME=Project

# === OpenAI Configuration ===
OPENAI_API_KEY=your_openai_api_key

# === Project Timeline ===
PROJECT_START_TIME=2024-10-21T00:00:00
WEEKS=12

# === Workspace Path for SonarScanner ===
# IMPORTANT: Use FORWARD SLASHES (/) even on Windows!
# This path is used by Docker to mount the workspace volume for SonarScanner.
# Example Windows: C:/Users/YourName/Desktop/zsd 2.0/backend/workspace
# Example Linux/Mac: /home/yourname/zsd 2.0/backend/workspace
HOST_WORKSPACE_DIR=C:/path/to/your/backend/workspace
