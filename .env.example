# GitHub Token (create one at https://github.com/settings/tokens)
GITHUB_TOKEN=ghp_example1234567890

# OpenAI API Key for Agent functionality
OPENAI_API_KEY=sk-example1234567890

# Database Connection Strings
# For local running: mongodb://mongodb:27017 or Cloud URI
MONGO_URI=mongodb://mongodb:27017

# Main Repository for Analysis (Default fallback)
GITHUB_URL=https://github.com/owner/repo
OWNER=owner
REPO_NAME=repo
MAIN_BRANCH=main

# SonarQube Configuration
# Default login is admin/admin, generates a token in SonarQube UI
SONAR_TOKEN=squ_example1234567890
SONAR_HOST_URL=http://sonarqube:9000
SONAR_API_URL=http://sonarqube:9000
SONAR_PROJECT_KEY=my_project_key
SONAR_PROJECT_NAME=MyProject

# Analysis Parameters
PROJECT_START_TIME=2023-01-01
WEEKS=10

# Workspace (Optional override)
# HOST_WORKSPACE_DIR=./backend/workspace
